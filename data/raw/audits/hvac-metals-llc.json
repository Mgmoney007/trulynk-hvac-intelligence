          {
            "@type": "FAQPage",
            "@id": "https://www.hvacmetalsllc.com/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Where is HVAC Metals LLC located and what areas do you serve?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "HVAC Metals LLC is hyper-locally situated at 181-183 Garfield Ave in Kearny, New Jersey. We provide direct job site deliveries of custom ductwork and HVAC supplies to commercial contractors across all of NJ, New York City (NY), and Eastern Pennsylvania (PA)."
                }
              },
              {
                "@type": "Question",
                "name": "What types of custom HVAC sheet metal products do you manufacture?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "We operate a full-service B2B fabrication shop producing custom rectangular, spiral, and oval ductwork. We also manufacture HVAC roof curbs, curb adapters, and equipment rails using high-quality galvanized steel, stainless steel, and aluminum."
                }
              },
              {
                "@type": "Question",
                "name": "Do you sell HVAC supplies to homeowners or the general public?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No, HVAC Metals LLC is strictly a B2B wholesale manufacturer and supplier. We partner exclusively with licensed HVAC contractors, mechanical contractors, and sheet metal installers. We do not offer retail sales, DIY supplies, or residential home AC repairs."
                }
              },
              {
                "@type": "Question",
                "name": "What advanced metal fabrication services do you offer in your New Jersey shop?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Our Kearny, NJ facility is equipped for precision manufacturing, offering advanced panel bending, precision laser cutting, custom welding, and exact shop drawings to ensure your commercial ductwork meets all local tri-state building codes."
                }
              },
              {
                "@type": "Question",
                "name": "How fast can you deliver custom ductwork to job sites in NJ and NY?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "We prioritize fast turnaround times for our contractor partners. Using our own dedicated fleet of box trucks, we schedule job site deliveries as early as 6:00 AM throughout New Jersey and the NYC metropolitan area to keep your installation crews moving."
                }
              }
            ]
          }
        ]
